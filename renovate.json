{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "dependencyDashboard": false,
  "timezone": "Europe/Copenhagen",
  "labels": [
    "renovate"
  ],
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "ignorePaths": [
    "**/*.sops.yaml",
    "kubernetes/clusters/homelab/flux-system/**"
  ],
  "flux": {
    "managerFilePatterns": [
      "/kubernetes/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/kubernetes/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Talos and Kubernetes versions, annotated with a '# renovate:' comment.",
      "managerFilePatterns": [
        "/^terraform/platform/talos-versions\\.auto\\.tfvars$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "github-actions": {
    "managerFilePatterns": [
      "/^\\.github/workflows/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Terraform is not live-tested, so nothing under terraform/ gets PRs. The Talos/Kubernetes version file is the one exception, further down.",
      "matchFileNames": ["terraform/**"],
      "enabled": false
    },
    {
      "description": "Upgrade the two Actions Runner Controller charts together when both have updates.",
      "matchManagers": ["flux"],
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set-controller",
        "ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set"
      ],
      "groupName": "actions-runner-controller"
    },
    {
      "description": "Group compatible monitoring chart updates; keep major upgrades separate for review.",
      "matchManagers": ["flux"],
      "matchFileNames": ["kubernetes/apps/monitor/controllers/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "monitoring charts"
    },
    {
      "description": "Combine routine workflow updates without coupling them to cluster changes.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Keep major bumps on their own so an infra major never rides along with something else.",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major-update"
      ]
    },
    {
      "description": "renovatebot/github-action: track minor + major only. Patch bumps of the Renovate engine wrapper are noise; minors/majors (behaviour changes) still get a PR + live-test gate.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "renovatebot/github-action"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "Talos and Kubernetes bumps. One PR each, never automerged. Merging only changes Terraform inputs; the upgrade itself is manual (docs/talos-k8s-versions.md).",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["terraform/platform/talos-versions.auto.tfvars"],
      "enabled": true,
      "automerge": false,
      "separateMinorPatch": true,
      "addLabels": ["manual-upgrade"]
    },
    {
      "description": "Kubernetes tags carry a 'v', the Talos provider input does not.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["kubernetes/kubernetes"],
      "extractVersion": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ]
}
