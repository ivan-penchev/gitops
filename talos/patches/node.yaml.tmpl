# Per-node patch: hostname + static IP (replaces the maintenance-mode DHCP lease).
# Control-plane nodes additionally get the shared API VIP on the same interface.
#
# Hostname is set via the standalone HostnameConfig document (Talos >=1.11), NOT
# via machine.network.hostname. The talos provider already emits a HostnameConfig
# doc with `auto: stable`; setting a v1alpha1 hostname alongside it triggers
# "static hostname is already set in v1alpha1 config". Overriding that doc with
# `auto: off` + a static hostname is the only combination that validates.
machine:
  # proxmox-csi requires topology labels; zone MUST equal the Proxmox node name
  # and region MUST match the `region` field in the proxmox-csi cloud-config
  # secret. region/zone are in the kubelet-allowed label set, so Talos can apply
  # them via machine.nodeLabels without NodeRestriction rejecting them.
  nodeLabels:
    topology.kubernetes.io/region: ${region}
    topology.kubernetes.io/zone: ${zone}
  network:
    interfaces:
      - deviceSelector:
          driver: virtio_net
        dhcp: false
        addresses:
          - ${ip}/${cidr}
        routes:
          - network: 0.0.0.0/0
            gateway: ${gateway}
%{ if vip != "" ~}
        vip:
          ip: ${vip}
%{ endif ~}
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: ${hostname}
