#!/bin/bash
# Power the USB backup drive on or off by disabling its USB port.
# A USB 3 socket is two kernel ports, a USB 3 one and a USB 2 peer. Both get disabled,
# otherwise the drive reconnects through the other one.
set -euo pipefail
# shellcheck source=tank-backup.default
. /etc/default/tank-backup
STATE=/var/lib/usb-drive/ports

usb_device_dir() {
  local d
  d=$(readlink -f "/sys/block/$(basename "$(readlink -f "$DISK_ID")")")
  while [ "$d" != / ]; do
    if [ -e "$d/idVendor" ] && [ -e "$d/port" ]; then echo "$d"; return; fi
    d=$(dirname "$d")
  done
  echo "usb-drive: no USB port found for $DISK_ID" >&2; exit 1
}

ports_of_drive() {
  local p; p=$(readlink -f "$(usb_device_dir)/port")
  echo "$p $(readlink -f "$p/peer" 2>/dev/null || true)"
}

wait_for() { # $1 = present|absent
  for _ in $(seq 1 120); do
    if [ "$1" = present ]; then [ -e "$DISK_ID" ] && return 0; else [ -e "$DISK_ID" ] || return 0; fi
    sleep 0.5
  done
  return 1
}

case "${1:-}" in
  off)
    if [ ! -e "$DISK_ID" ]; then echo "usb-drive: already off or unplugged"; exit 0; fi
    if zpool list "$POOL" >/dev/null 2>&1; then echo "usb-drive: pool $POOL is imported, export it first" >&2; exit 1; fi
    mkdir -p "$(dirname "$STATE")"; ports_of_drive > "$STATE"
    read -r p peer < "$STATE"
    sync
    # Cut on a USB 3 link, the enclosure keeps the disk spinning. Drop it to
    # USB 2 first by disabling the USB 3 port, then disable the USB 2 port.
    if [ -n "$peer" ] && [ "$(cat "$(usb_device_dir)/speed")" -ge 5000 ]; then
      echo 1 > "$p/disable"
      wait_for absent || { echo "usb-drive: drive is still on the bus" >&2; exit 1; }
      wait_for present || echo "usb-drive: drive did not reconnect on USB 2" >&2
      sleep 3
      echo 1 > "$peer/disable"
    else
      [ -n "$peer" ] && echo 1 > "$peer/disable"
      echo 1 > "$p/disable"
    fi
    wait_for absent || { echo "usb-drive: drive is still on the bus" >&2; exit 1; }
    echo "usb-drive: off"
    ;;
  on)
    if [ -e "$DISK_ID" ]; then echo "usb-drive: already on"; exit 0; fi
    [ -s "$STATE" ] || { echo "usb-drive: don't know its port, replug the drive" >&2; exit 1; }
    read -r p peer < "$STATE"
    echo 0 > "$p/disable"
    [ -n "$peer" ] && echo 0 > "$peer/disable"
    wait_for present || { echo "usb-drive: drive did not come back, replug it" >&2; exit 1; }
    udevadm settle
    echo "usb-drive: on, $(readlink -f "$DISK_ID") at $(cat "$(usb_device_dir)/speed")M"
    ;;
  status)
    [ -e "$DISK_ID" ] && echo on || echo off
    ;;
  *) echo "usage: usb-drive on|off|status" >&2; exit 2 ;;
esac
